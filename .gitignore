# Local Claude Code tool config -- machine-specific, not project source
.claude/

# Dashboard run-registry persistence (ephemeral job state, not source of truth)
backend/.runs/

# Step 5 data retention (docs/Agent prompt grounding factor ui.md) -- new
# file types that did not exist before this round of work. Large at
# n=384 scale (manifests duplicate response metadata already in the
# output file; failures/resolution logs can grow across many retried
# runs) -- kept out of git going forward, archived instead via
# archive_results.py. Does NOT retroactively untrack anything already
# committed (the existing n=10 pilot results/*.jsonl stay tracked,
# unchanged, unless you decide otherwise -- see docs/
# GROUNDING_FACTOR_UI_STEP5_REPORT.md's git in/out breakdown).
*.manifest.json
llm/evaluation/results/*_failures.jsonl
llm/evaluation/results/*_failures_resolved.jsonl

# Per-dashboard-run log files (one per run_id, grows unbounded) -- see
# engine_service.py::_run_log_path(). logs/invalid_runs.jsonl itself
# (repo root, NOT under llm/*/logs/) stays tracked -- it's a small,
# deliberately-curated audit record, not per-run noise.
llm/*/logs/dashboard_*.log
Icon?

# macOS Finder metadata -- never track
.DS_Store
**/.DS_Store

# C v3 candidate-embedding cache (speed-up only; default lives outside the repo,
# see llm/c_graphrag/embedding_cache.py) and retrieval-only resume sidecars
embedding_cache.sqlite3*
*.resume.json

# Condition B KG-answer corpus (llm/b_rag/build_kg_answer_index.py) -- parquet
# export, embedding memmaps, FAISS index + meta, checkpoints and build log.
# Large, rebuilt locally; never committed. (The legacy idx*_tok400 pilot
# index files already tracked under index_cache/ are left as they are.)
llm/b_rag/index_cache/kg_answers_*/
llm/b_rag/index_cache/**/*.parquet
llm/b_rag/index_cache/**/*.f32
llm/b_rag/index_cache/**/*.i64

# Leakage audit retrieval dumps (llm/leakage/audit.py) -- large, regenerable; summary.json is kept
results/leakage/audit/*.jsonl

# Pre-official archive (2026-10-19; results/_archive/2026-10-19_pre-official/
# ARCHIVE_INDEX.md). Files keep their original repo-relative path under the
# archive root; a file that was git-ignored at its original path stays ignored
# in the archive (manifest/resume/Icon/.DS_Store rules above are global).
results/_archive/*/llm/evaluation/results/*_failures.jsonl
results/_archive/*/llm/evaluation/results/*_failures_resolved.jsonl
results/_archive/*/results/leakage/audit/*.jsonl
results/_archive/*/backend/.runs/
logs/_archive/*/llm/a_pure_llm/logs/
logs/_archive/*/llm/b_rag/logs/
logs/_archive/*/llm/*/logs/dashboard_*.log
claude_judge/
results/
llm/b_rag/results/
claude_judge/
results/
llm/b_rag/results/
